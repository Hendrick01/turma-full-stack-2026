algoritmo "Contagem Regressiva"
// Aula 05 - Exercicio 06 - Estrutura ENQUANTO
// Exibe os numeros de 10 ate 1 e depois a mensagem final.
var
   contador: inteiro
inicio
   contador <- 10

   enquanto (contador >= 1) faca
      escreval(contador)
      contador <- contador - 1
   fimenquanto

   escreval("Feliz Ano Novo!")
fimalgoritmo
