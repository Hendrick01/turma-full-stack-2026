algoritmo "Processo Seletivo"
// Aula 03 - Exercicio 12 - Operadores Relacionais
// Nota minima de aprovacao: 70 pontos.
var
   nota: real
inicio
   escreva("Digite a nota do candidato: ")
   leia(nota)

   se (nota >= 70) entao
      escreval("Candidato APROVADO no processo seletivo.")
   senao
      escreval("Candidato REPROVADO no processo seletivo.")
   fimse
fimalgoritmo
