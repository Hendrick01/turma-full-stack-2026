algoritmo "Media Aritmetica"
// Aula 03 - Exercicio 02 - Operadores Aritmeticos
// Le duas notas e calcula a media aritmetica.
var
   nota1, nota2, media: real
inicio
   escreva("Digite a 1ª nota: ")
   leia(nota1)

   escreva("Digite a 2ª nota: ")
   leia(nota2)

   media <- (nota1 + nota2) / 2

   escreval("Média aritmética: ", media:1:2)
fimalgoritmo
